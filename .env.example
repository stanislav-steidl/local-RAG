# Copy to `.env` and adjust. All settings may also be passed as environment
# variables using the LOCAL_RAG_ prefix.
#
# `.env` is git-ignored: it points at private data and must never be committed.

# Absolute path to the document corpus to index. Required.
LOCAL_RAG_CORPUS_DIR=/path/to/your/documents

# Where the LanceDB index is written. Keep this outside the corpus directory.
LOCAL_RAG_INDEX_DIR=./.lancedb

# Embedding model identifier (HuggingFace hub id).
LOCAL_RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Chunking, in characters.
LOCAL_RAG_CHUNK_SIZE=1200
LOCAL_RAG_CHUNK_OVERLAP=200

# Ollama model used for answer generation.
LOCAL_RAG_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOCAL_RAG_LOG_LEVEL=INFO
